graph TB
    classDef gh fill:#fff2cc,stroke:#d6b656
    classDef ci fill:#d5e8d4,stroke:#82b366
    classDef deploy fill:#dae8fc,stroke:#6c8ebf
    classDef aws fill:#ffe6cc,stroke:#d79b00
    classDef data fill:#f8cecc,stroke:#b85450
    classDef stop fill:#f5f5f5,stroke:#b85450,stroke-dasharray:3

    DEV["Desenvolvedor"]

    subgraph GitHubActions["GitHub Actions"]
        direction TB

        subgraph CI["ci.yml - PR e push em develop, homolog e main"]
            direction TB
            C1["commits (só PR)<br/>título em Conventional Commits<br/>até 72 caracteres, sem tipos proibidos"]
            C2["terraform - matriz staging e prod<br/>fmt -check -recursive<br/>init -backend=false + validate"]
            C3["testes<br/>terraform test em modules/database<br/>provider mockado, command = plan"]
            C4["seguranca<br/>trivy config MEDIUM+<br/>com .trivyignore"]
            C5["contrato<br/>9 outputs nos dois ambientes<br/>sem endpoint literal, sem chave estática<br/>chave do lab só com session token<br/>prod endurecida, .trivyignore justificado"]
        end

        subgraph DEPLOY["deploy.yml - push em develop, homolog e main (ou manual)"]
            direction TB
            subgraph PLAN["job plan - sem environment, secrets do repositório"]
                direction TB
                P1["credenciais AWS<br/>OIDC (AWS_DEPLOY_ROLE)<br/>ou lab do AWS Academy com session token"]
                P2["terraform init<br/>-backend-config bucket=TF_STATE_BUCKET"]
                P3["terraform plan -out=tfplan"]
                P4{"o plan destrói<br/>aws_db_instance?"}
                P5["plano no resumo do run<br/>artifact só com endereços e ações"]
            end
            G["gate do environment<br/>staging ou production<br/>production com aprovação"]
            subgraph APPLY["job apply - no environment"]
                direction TB
                A1["terraform init e plan de novo"]
                A2{"plano igual ao aprovado<br/>e sem destruir o banco?"}
                A3["terraform apply tfplan"]
                A4["confere os 7 parâmetros<br/>em /techchallenge/&lt;env&gt;/db/"]
            end
            X["job falha<br/>nada é aplicado"]
        end
    end

    subgraph AWS["AWS"]
        direction TB
        S3[("S3 TF_STATE_BUCKET<br/>db/staging · db/prod")]
        RDS[("RDS PostgreSQL 15<br/>techchallenge-&lt;env&gt;")]
        SSM["SSM Parameter Store<br/>contrato de conexão"]
    end

    DEV -->|"PR / push"| CI
    DEV -->|"push develop ou homolog → staging<br/>push main → prod"| DEPLOY

    P1 --> P2 --> P3 --> P4
    P4 -->|"não"| P5 --> G --> A1 --> A2
    P4 -->|"sim"| X
    A2 -->|"sim"| A3 --> A4
    A2 -->|"não"| X

    P2 -.->|"lock e state"| S3
    A3 -->|"cria / altera"| RDS
    A3 -->|"publica"| SSM
    A4 -.->|"get-parameter"| SSM

    style GitHubActions fill:#fbfbfb,stroke:#999,stroke-dasharray:3
    style AWS fill:#fdf4ec,stroke:#999,stroke-dasharray:3
    style CI fill:#f3f9f3
    style DEPLOY fill:#f3f7fb

    class DEV gh
    class C1,C2,C3,C4,C5 ci
    class G,P1,P2,P3,P4,P5,A1,A2,A3,A4 deploy
    class X stop
    class S3,SSM aws
    class RDS data
